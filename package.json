{
  "name": "sarjy",
  "version": "0.1.0",
  "private": true,
  "description": "A voice assistant that remembers what you tell it, answers from real tools, and shows you everything it keeps.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "docs:reader": "node scripts/docs-reader/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "marked": "^18.0.14",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.52",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^7.0.122",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
