# Copy to .env.local and fill in. .env.local is git-ignored.
# In production these live in Vercel project settings, never in the repo.
# None of these may be prefixed with NEXT_PUBLIC_ (that would ship them to the browser).

# Groq: speech-to-text (Whisper), the language model, and text-to-speech (Orpheus)
GROQ_API_KEY=

# Postgres connection string (Neon via the Vercel Marketplace)
DATABASE_URL=

# Signs the anonymous session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Ably: multiplayer rooms (server publishes, browsers get short-lived tokens)
ABLY_API_KEY=

# fake (default for local work and tests) or live
SARJY_PROVIDERS=fake
